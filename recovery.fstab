# Mount point    fstype    device                                  flags
/boot            emmc      /dev/block/by-name/boot                 flags=display="Boot";backup=1;flashimg=1
/vendor_boot     emmc      /dev/block/by-name/vendor_boot          flags=display="Vendor Boot";backup=1;flashimg=1
/recovery        emmc      /dev/block/by-name/recovery             flags=display="Recovery";backup=1;flashimg=1
/cache           ext4      /dev/block/by-name/cache                 flags=display="Cache"
/data            f2fs      /dev/block/by-name/userdata              flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0;metadata_encryption=aes-256-xts;keydirectory=/metadata/vold/metadata_encryption
/metadata        ext4      /dev/block/by-name/metadata              flags=display="Metadata";backup=1
/misc            emmc      /dev/block/by-name/misc                 flags=display="Misc"

# Dynamic Partitions
/system_image    emmc      system                                  flags=display="System Image";backup=1;flashimg=1
/vendor_image    emmc      vendor                                  flags=display="Vendor Image";backup=1;flashimg=1
/product_image   emmc      product                                 flags=display="Product Image";backup=1;flashimg=1

# External Storage (SD Card & USB-OTG)
/external_sd     vfat      /dev/block/mmcblk0p1 /dev/block/mmcblk0 flags=display="MicroSD";storage;wipeingui;removable
/usb_otg         vfat      /dev/block/sdb1      /dev/block/sdb     flags=display="USB-OTG";storage;wipeingui;removable
